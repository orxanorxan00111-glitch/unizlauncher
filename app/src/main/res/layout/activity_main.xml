<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#101010" android:padding="28dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="UNIZ Light Control" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />

    <TextView android:id="@+id/connStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Car servisinə qoşulur..." android:textColor="#999999" android:textSize="16sp" />

    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:columnCount="2" android:rowCount="2">

        <Button android:id="@+id/btnLeftTurn" android:layout_width="0dp" android:layout_height="90dp"
            android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/btn_bg"
            android:text="Sol dönmə" android:textColor="#FFFFFF" android:textSize="20sp" android:textAllCaps="false" />

        <Button android:id="@+id/btnRightTurn" android:layout_width="0dp" android:layout_height="90dp"
            android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/btn_bg"
            android:text="Sağ dönmə" android:textColor="#FFFFFF" android:textSize="20sp" android:textAllCaps="false" />

        <Button android:id="@+id/btnFog" android:layout_width="0dp" android:layout_height="90dp"
            android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/btn_bg"
            android:text="Duman işığı" android:textColor="#FFFFFF" android:textSize="20sp" android:textAllCaps="false" />

        <Button android:id="@+id/btnHazard" android:layout_width="0dp" android:layout_height="90dp"
            android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/btn_bg"
            android:text="Hər ikisi (4-lük)" android:textColor="#FFFFFF" android:textSize="20sp" android:textAllCaps="false" />
    </GridLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="Jurnal:" android:textColor="#777777" android:textSize="14sp" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp">
        <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textColor="#00E676" android:textSize="13sp" android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
